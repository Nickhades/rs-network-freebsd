#!/bin/sh

# PROVIDE: netcore
# REQUIRE: dbus
# BEFORE: LOGIN
# KEYWORD: shutdown

# Add the following to /etc/rc.conf:
#   netcore_enable="YES"
#
# Optional:
#   netcore_flags="--log netcore_daemon=debug"
#   netcore_logfile="/var/log/netcore.log"

. /etc/rc.subr

name="netcore"
rcvar="netcore_enable"
desc="Native FreeBSD network manager"

load_rc_config "${name}"

: ${netcore_enable:="NO"}
: ${netcore_logfile:="/var/log/netcore.log"}
: ${netcore_flags:=""}

procname="/usr/local/sbin/netcore-daemon"
pidfile="/var/run/netcore.pid"
required_files="${procname}"

# Start the daemon directly in the background.  Using daemon(8) here made the
# supervisor pidfile disappear early on some boots, leaving status broken.
command="${procname}"
start_cmd="netcore_start"
start_precmd="netcore_prestart"
start_postcmd="netcore_poststart"

netcore_prestart()
{
    install -d -o root -g wheel -m 755 /var/run
    touch "${netcore_logfile}"
    chmod 640 "${netcore_logfile}"
    return 0
}

netcore_start()
{
    /usr/bin/nohup "${procname}" --bus system ${netcore_flags} \
        >> "${netcore_logfile}" 2>&1 &
    echo $! > "${pidfile}"
    return 0
}

# daemon(8) creates the pidfile 0600; make status work for wheel users.
netcore_poststart()
{
    # daemon(8) normally writes the child pidfile.  Keep management working
    # even on systems where the supervisor was reaped early.
    if [ ! -s "${pidfile}" ]; then
        pid=$(/usr/bin/pgrep -x netcore-daemon | head -n 1)
        [ -n "$pid" ] && printf "%s\n" "$pid" > "${pidfile}"
    fi
    [ -f "${pidfile}" ] && chmod 0644 "${pidfile}" 2>/dev/null
    return 0
}

run_rc_command "$1"
